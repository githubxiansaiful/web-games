{
    # Global options
    email {$SSL_EMAIL:admin@example.com}
}

# Production Domain with Automatic Let's Encrypt SSL & WebSocket Proxy
{$DOMAIN:localhost} {
    encode gzip zstd

    # Security & Privacy Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Reverse proxy to Xian's Game World (Next.js + Socket.io)
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # WebSocket support is enabled out of the box in Caddy
    }

    # Cache static assets
    @static {
        path /_next/static/* /favicon.ico /icon* /apple-icon*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
}
